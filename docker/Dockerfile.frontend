# ============================================================
# Dockerfile.frontend
# Contexto de build: raiz del proyecto
# Uso: docker build -f docker/Dockerfile.frontend -t unt-frontend .
# ============================================================

# ------- Etapa 1: Build -------
FROM node:18-alpine AS builder

WORKDIR /app

# Copiar package files del frontend
COPY frontend/package*.json ./

# Instalar dependencias del frontend
RUN npm install

# Copiar el codigo fuente del frontend
COPY frontend/. .

# Copiar tipos de tRPC desde el backend (necesarios para la compilacion)
COPY backend/src/app.router.ts ../backend/src/app.router.ts
COPY backend/package*.json ../backend/

# Instalar solo las dependencias de tipo del backend (sin scripts post-install)
RUN cd ../backend && npm install --ignore-scripts --omit=optional 2>/dev/null || \
    npm install --ignore-scripts @trpc/server@^10.45.0 zod@^3.22.0

# Variables de entorno de build (NEXT_PUBLIC_* deben estar presentes al compilar)
ARG NEXT_PUBLIC_API_URL=http://localhost:3000
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

# Compilar la aplicacion Next.js
RUN npm run build

# ------- Etapa 2: Produccion -------
FROM node:18-alpine AS production

WORKDIR /app

# Crear usuario no root
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001

# Copiar el servidor standalone generado por Next.js
COPY --from=builder --chown=nodejs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nodejs:nodejs /app/.next/static ./.next/static
RUN mkdir -p ./public
COPY --from=builder --chown=nodejs:nodejs /app/public ./public

# Cambiar a usuario no root
USER nodejs

ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
ENV PORT=3000

EXPOSE 3000

CMD ["node", "server.js"]
