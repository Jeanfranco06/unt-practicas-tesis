# Archivos de ejemplo para variables de entorno de producción

# ============================================
# BASE DE DATOS
# ============================================
DB_HOST=postgres
DB_PORT=5432
DB_USER=unt_prod_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE_MIN_32_CHARS
DB_NAME=unt_practicas_tesis_prod

# ============================================
# REDIS
# ============================================
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD_MIN_32_CHARS
REDIS_PORT=6379

# ============================================
# BACKEND
# ============================================
NODE_ENV=production
BACKEND_PORT=3000
PORT=3000

# ============================================
# JWT SECRETS
# ============================================
JWT_SECRET=CHANGE_ME_JWT_SECRET_VERY_LONG_AND_RANDOM_STRING_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_JWT_REFRESH_SECRET_VERY_LONG_AND_RANDOM_STRING_MIN_32_CHARS
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# URLs
# ============================================
API_URL=https://api.yourdomain.com
FRONTEND_URL=https://yourdomain.com

# ============================================
# FRONTEND
# ============================================
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
FRONTEND_PORT=3000

# ============================================
# EMAIL (Opcional)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@yourdomain.com

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info

# ============================================
# CORS
# ============================================
CORS_ORIGIN=https://yourdomain.com

# ============================================
# FILE UPLOAD
# ============================================
MAX_FILE_SIZE=20M
UPLOAD_PATH=/app/uploads
