# Etapa de construcción
FROM node:18-alpine AS builder

WORKDIR /app

# Copiar package files
COPY package*.json ./

# Instalar dependencias para construcción (incluyendo devDependencies para @nestjs/cli)
RUN npm install --unsafe-perm

# Copiar código fuente
COPY . .

# Construir la aplicación
RUN npm run build

# Etapa de producción
FROM node:18-alpine AS production

WORKDIR /app

ARG NODE_ENV=production
ENV NODE_ENV=$NODE_ENV

# Crear usuario no root
RUN addgroup -g 1001 nodejs && adduser -D -u 1001 -G nodejs nodejs

# Instalar curl para health checks
RUN apk add --no-cache curl

# Copiar package files
COPY package*.json ./

# Instalar solo dependencias de producción
RUN npm ci --omit=dev && npm cache clean --force

# Copiar código construido
COPY --from=builder /app/dist ./dist

# Copiar archivos necesarios y dar permisos
COPY package*.json ./
COPY entrypoint.sh /entrypoint.sh

RUN chmod +x /entrypoint.sh && \
    mkdir -p /app/upload/convenios /app/upload/cv && \
    chown -R nodejs:nodejs /app /entrypoint.sh && \
    chmod -R 755 /app/upload

# Cambiar al usuario no root
USER nodejs

# Exponer puerto
EXPOSE 8080

# Health check - crítico para Cloud Run
HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8080/api/health || exit 1

# Usar entrypoint script que maneja Cloud SQL Proxy
ENTRYPOINT ["/entrypoint.sh"]
