# Etapa de construcción
FROM node:18-slim AS builder

WORKDIR /app

ARG NODE_ENV=production
ENV NODE_ENV=$NODE_ENV

# Instalar build essentials para módulos nativos
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

# Copiar package files
COPY package*.json ./

# Instalar dependencias para construcción
RUN npm ci --unsafe-perm

# Auditar y arreglar vulnerabilidades (non-breaking changes)
RUN npm audit fix || true

# Copiar código fuente
COPY . .

# Construir la aplicación
RUN npm run build

# Etapa de producción
FROM node:18-slim AS production

WORKDIR /app

ARG NODE_ENV=production
ENV NODE_ENV=$NODE_ENV

# Crear usuario no root
RUN groupadd -g 1001 nodejs && useradd -r -u 1001 -g nodejs nodejs

# Instalar dumb-init para manejo de señales
RUN apt-get update && apt-get install -y --no-install-recommends \
    dumb-init curl \
    && rm -rf /var/lib/apt/lists/*

# Copiar package files
COPY package*.json ./

# Instalar solo dependencias de producción
RUN npm ci --only=production && npm cache clean --force

# Copiar código construido
COPY --from=builder /app/dist ./dist

# Copiar otros archivos necesarios
COPY --chown=nodejs:nodejs . .

# Cambiar al usuario no root
USER nodejs

# Exponer puerto
EXPOSE 3000

# Usar dumb-init como init para manejo de señales
ENTRYPOINT ["dumb-init", "--"]

# Comando de inicio
CMD ["npm", "run", "start:prod"]
