# .gcloudignore - files NOT to upload to Cloud Build
# This file overrides the default .gitignore behavior

# Node modules (will be installed via npm ci)
**/node_modules/
**/dist/
**/coverage/
**/build/

# Development files
.env
.env.local
.env.*.local
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# Docker
.dockerignore

# Test files (but NOT package-lock.json!)
.nyc_output/
jest.config.js
playwright.config.*

# Keep backend/package-lock.json for reproducible builds!
# Do NOT ignore it - it's needed for npm ci
!backend/package-lock.json
